{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [".next/", "out/", "build/", "next-env.d.ts", "public/"],
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }]
  }
}
